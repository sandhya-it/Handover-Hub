# GEMINI_API_KEY: Required for live Gemini AI document extraction & handover synthesis.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Optional: Supabase PostgreSQL + Storage configuration for external persistence.
# When omitted, Handover Hub runs with persistent local/demo storage.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SESSION_SECRET=""
